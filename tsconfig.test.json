{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": ".test-build",
    "noEmit": false,
    "declaration": false,
    "sourceMap": false,
    "incremental": false,
    "types": ["node"]
  },
  "include": [
    "tests/**/*.ts",
    "lib/products/**/*.ts",
    "data/**/*.ts",
    "types/**/*.ts"
  ]
}
